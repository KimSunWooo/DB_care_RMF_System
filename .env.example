# mock: run without ROS / RMF / Isaac Sim (default)
# rmf: send tasks only after fleet and navigation-graph checks succeed
CARE_MOVE_MODE=mock
# Required in rmf mode. Do not assume a port; point this at the running API.
RMF_API_URL=http://127.0.0.1:8000
RMF_FLEET_NAME=care_move
# static: send this bearer token and do not mint a replacement.
# local_jwt: ignore this value and sign tokens in the server process.
RMF_API_TOKEN=
# static or local_jwt. A broken local_jwt config does not fall back to static.
RMF_AUTH_MODE=static
# Required only for local_jwt. Placeholder only; put the real value in .env.
RMF_JWT_SECRET=
RMF_JWT_ALGORITHM=HS256
RMF_JWT_ISSUER=stub
RMF_JWT_AUDIENCE=rmf_api_server
RMF_JWT_USERNAME=admin
RMF_JWT_TTL_SECONDS=3600
RMF_JWT_ROTATE_INTERVAL_SECONDS=2700
RMF_JWT_EXPIRY_SKEW_SECONDS=60
RMF_API_TIMEOUT=5
RMF_POLL_INTERVAL_SEC=2
# After a 401, wait this many seconds before another authenticated probe.
RMF_AUTH_RETRY_SEC=30
# Bind to loopback only: test code has no user authentication
CARE_MOVE_BIND=127.0.0.1
CARE_MOVE_PORT=8010
